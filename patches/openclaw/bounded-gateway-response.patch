+/** Receive limits apply to a complete, decompressed WebSocket message. */
+export const DEFAULT_GATEWAY_MAX_PAYLOAD_BYTES = 25 * 1024 * 1024;
+export const MAX_GATEWAY_MAX_PAYLOAD_BYTES = 64 * 1024 * 1024;
+export function resolveGatewayMaxPayloadBytes(value?: number): number {
+  if (value === undefined) return DEFAULT_GATEWAY_MAX_PAYLOAD_BYTES;
+  if (!Number.isSafeInteger(value) || value < 1 || value > MAX_GATEWAY_MAX_PAYLOAD_BYTES) {
+    throw new Error("Gateway maxPayloadBytes must be an integer between 1 and 67108864");
+  }
+  return value;
+}
