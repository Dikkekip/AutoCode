index 0000000000000000000000000000000000000000..e57e252720ca4ae394d8fb9c11e60b8ce2b910b8
--- /dev/null
+++ b/packages/gateway-client/src/response-limit.ts
@@ -0,0 +1,17 @@
+/** Receive limits apply to a complete, decompressed WebSocket message. */
+const DEFAULT_GATEWAY_MAX_PAYLOAD_BYTES = 25 * 1024 * 1024;
+const MAX_GATEWAY_MAX_PAYLOAD_BYTES = 64 * 1024 * 1024;
+export function resolveGatewayMaxPayloadBytes(value?: number): number {
+  if (value === undefined) {
+    return DEFAULT_GATEWAY_MAX_PAYLOAD_BYTES;
+  }
+  if (!Number.isSafeInteger(value) || value < 0 || value > MAX_GATEWAY_MAX_PAYLOAD_BYTES) {
+    throw new Error("Gateway maxPayloadBytes must be an integer between 0 and 67108864");
+  }
+  return value;
+}
+
+export type GatewayResponseLimitOptions = {
+  /** Complete-message receive bound; default 25 MiB; zero disables the cap, positive ceiling 64 MiB. */
+  maxPayloadBytes?: number;
+};
