index 0000000000000000000000000000000000000000..f03f9f2de25e4e91fc82dfc826a25029fa36a9dc
--- /dev/null
+++ b/src/cli/gateway-rpc.response-limit.test.ts
@@ -0,0 +1,186 @@
+// Regression boundary: public SDK -> lazy runtime -> actual call owner -> wire.
+// Tiny finite caps expose forwarding errors without another large payload fixture.
+import { randomUUID } from "node:crypto";
+import { once } from "node:events";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import { rawDataToString } from "../../packages/gateway-client/src/websocket-data.js";
+import { WebSocketServer } from "../../packages/gateway-client/src/websocket.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+
+let state: string;
+let server: WebSocketServer;
+let port: number;
+let authenticated = 0;
+let requests = 0;
+const token = randomUUID();
+const evidence = "synthetic-evidence-ø".repeat(256);
+let sdk: typeof import("../plugin-sdk/gateway-runtime.js");
+
+beforeAll(async () => {
+  state = await mkdtemp(join(tmpdir(), "gateway-response-sdk-"));
+  vi.stubEnv("OPENCLAW_STATE_DIR", state);
+  vi.stubEnv("OPENCLAW_CONFIG_PATH", join(state, "missing-config.json"));
+  for (const name of [
+    "OPENCLAW_GATEWAY_URL",
+    "OPENCLAW_GATEWAY_TOKEN",
+    "OPENCLAW_GATEWAY_PASSWORD",
+  ]) {
+    vi.stubEnv(name, "");
+  }
+  sdk = await import("../plugin-sdk/gateway-runtime.js");
+  server = new WebSocketServer({ host: "127.0.0.1", port: 0, perMessageDeflate: false });
+  await once(server, "listening");
+  const address = server.address();
+  if (!address || typeof address === "string") {
+    throw new Error("Missing synthetic listener");
+  }
+  port = address.port;
+  server.on("connection", (socket) => {
+    socket.on("error", () => {});
+    socket.send(
+      JSON.stringify({
+        type: "event",
+        event: "connect.challenge",
+        payload: { nonce: "synthetic", ts: Date.now() },
+      }),
+    );
+    socket.on("message", (data) => {
+      const frame = JSON.parse(rawDataToString(data));
+      if (frame.method === "connect") {
+        if (
+          frame.params.auth?.token !== token ||
+          JSON.stringify(frame.params.scopes) !== JSON.stringify(["operator.read"])
+        ) {
+          socket.close(1008, "Synthetic authentication or scopes rejected");
+          return;
+        }
+        authenticated++;
+        socket.send(
+          JSON.stringify({
+            type: "res",
+            id: frame.id,
+            ok: true,
+            payload: {
+              type: "hello-ok",
+              protocol: 4,
+              server: { version: "synthetic", connId: "synthetic" },
+              features: { methods: ["workboard.cards.list"], events: [] },
+              snapshot: {
+                presence: [],
+                health: {},
+                stateVersion: { presence: 1, health: 1 },
+                uptimeMs: 1,
+              },
+              auth: { role: "operator", scopes: ["operator.read"] },
+              policy: { maxPayload: 524288, maxBufferedBytes: 1048576, tickIntervalMs: 30000 },
+            },
+          }),
+        );
+      } else if (
+        frame.method === "workboard.cards.list" &&
+        frame.params.boardId === "synthetic-board"
+      ) {
+        requests++;
+        socket.send(
+          JSON.stringify({
+            type: "res",
+            id: frame.id,
+            ok: true,
+            payload: { cards: [{ id: "one", metadata: { evidence } }], statuses: ["done"] },
+          }),
+          () => {},
+        );
+      } else {
+        socket.close(1008, "Unexpected synthetic request");
+      }
+    });
+  });
+});
+afterAll(async () => {
+  if (server) {
+    for (const socket of server.clients) {
+      socket.terminate();
+    }
+    await new Promise<void>((resolve) => {
+      server.close(() => resolve());
+    });
+  }
+  vi.unstubAllEnvs();
+  if (state) {
+    await rm(state, { recursive: true, force: true });
+  }
+});
+function options(config?: OpenClawConfig) {
+  return {
+    json: true,
+    timeout: "3000",
+    config: config ?? {
+      gateway: {
+        mode: "local" as const,
+        port,
+        bind: "loopback" as const,
+        auth: { mode: "token" as const, token },
+      },
+    },
+  };
+}
+const extra = {
+  scopes: ["operator.read"] as ["operator.read"],
+  progress: false,
+  deviceIdentity: null,
+  sharedStateMode: "read-only" as const,
+};
+const params = { boardId: "synthetic-board" };
+it("preserves the default and delivers complete uncapped responses through the authenticated SDK chain", async () => {
+  expect(sdk.callGatewayFromCli.responseLimitVersion).toBe(1);
+  const expected = { cards: [{ id: "one", metadata: { evidence } }], statuses: ["done"] };
+  await expect(
+    sdk.callGatewayFromCli("workboard.cards.list", options(), params, extra),
+  ).resolves.toEqual(expected);
+  await expect(
+    sdk.callGatewayFromCli("workboard.cards.list", options(), params, {
+      ...extra,
+      maxPayloadBytes: 1024,
+    }),
+  ).rejects.toThrow();
+  await expect(
+    sdk.callGatewayFromCli("workboard.cards.list", options(), params, {
+      ...extra,
+      maxPayloadBytes: 0,
+    }),
+  ).resolves.toEqual(expected);
+  expect(authenticated).toBe(3);
+  expect(requests).toBe(3);
+});
+it("rejects uncapped URL overrides, remote mode and missing shared auth before dispatch", async () => {
+  const before = authenticated;
+  const unsafe = [
+    { ...options(), url: `ws://127.0.0.1:${port}`, token },
+    options({ gateway: { mode: "remote", remote: { url: `ws://127.0.0.1:${port}`, token } } }),
+    options({ gateway: { mode: "local", port, auth: { mode: "none" } } }),
+  ];
+  for (const opts of unsafe) {
+    await expect(
+      sdk.callGatewayFromCli("workboard.cards.list", opts, params, {
+        ...extra,
+        maxPayloadBytes: 0,
+      }),
+    ).rejects.toThrow(/Uncapped Gateway responses/);
+  }
+  expect(authenticated).toBe(before);
+});
+it("rejects invalid explicit limits before dispatch", async () => {
+  const before = authenticated;
+  for (const maxPayloadBytes of [-1, Number.NaN, Infinity, 1.5, 67108865]) {
+    await expect(
+      sdk.callGatewayFromCli("workboard.cards.list", options(), params, {
+        ...extra,
+        maxPayloadBytes,
+      }),
+    ).rejects.toThrow(/maxPayloadBytes/);
+  }
+  expect(authenticated).toBe(before);
+});
