{
  "id": "execution-sweep",
  "schedule": {
    "cron": "2-59/10 * * * *",
    "timezone": "UTC"
  },
  "entry_agent": "main",
  "mode": "agent",
  "command": "python3 scripts/openclaw_director.py execution-sweep",
  "dry_run_supported": true,
  "writes_state": [
    ".openclaw/state/current/locks.json",
    ".openclaw/state/current/task-packages/",
    ".openclaw/state/current/runtime.json"
  ],
  "notifications": {
    "on_success": "silent",
    "on_failure": "alert"
  }
}
