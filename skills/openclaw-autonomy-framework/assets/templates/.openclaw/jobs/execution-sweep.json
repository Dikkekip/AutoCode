{
  "id": "execution-sweep",
  "schedule": {
    "cron": "2-59/10 * * * *",
    "timezone": "UTC"
  },
  "entry_agent": "main",
  "mode": "agent",
  "writes_state": [
    ".openclaw/state/current/locks.json",
    ".openclaw/state/current/task-packages/",
    ".openclaw/state/current/runtime.json"
  ],
  "notifications": {
    "on_success": "silent",
    "on_failure": "alert"
  }
}
