{
  "id": "review-sweep",
  "schedule": {
    "cron": "4-59/10 * * * *",
    "timezone": "UTC"
  },
  "entry_agent": "main",
  "mode": "agent",
  "writes_state": [
    ".openclaw/state/current/runtime.json",
    ".openclaw/state/current/reviews/"
  ],
  "notifications": {
    "on_success": "silent",
    "on_failure": "alert"
  }
}
