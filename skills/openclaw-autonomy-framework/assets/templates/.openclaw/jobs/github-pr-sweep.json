{
  "id": "github-pr-sweep",
  "schedule": {
    "cron": "8-59/15 * * * *",
    "timezone": "UTC"
  },
  "entry_agent": "main",
  "mode": "agent",
  "command": "python3 scripts/openclaw_director.py github-pr-sweep",
  "dry_run_supported": true,
  "writes_state": [
    ".openclaw/state/current/open_prs.json",
    ".openclaw/state/current/queue.json",
    ".openclaw/state/current/runtime.json"
  ],
  "notifications": {
    "on_success": "event",
    "on_failure": "alert"
  }
}
