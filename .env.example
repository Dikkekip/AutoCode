# Embeddings config for OpenClaw memory (kept separate from coder agent env)
EMBEDDING_OPENAI_BASE_URL=https://example-resource.cognitiveservices.azure.com/openai/v1/
EMBEDDING_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_AZURE_OPENAI_API_KEY=replace-me

# Azure Foundry requires an explicit endpoint; there are no built-in resources.
# OPENCLAW_AZURE_FOUNDRY_BASE_URLS=https://your-resource.services.ai.azure.com/openai/v1/
# OPENCLAW_AZURE_FOUNDRY_API_KEY=replace-me
