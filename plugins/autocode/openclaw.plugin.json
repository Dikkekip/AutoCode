{
  "id": "autocode",
  "name": "Autocode",
  "description": "Persona discovery, independent verification, and deployment gates on native Workboard.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projects": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "openclawCommand": {
        "type": "string",
        "description": "Absolute path to the active OpenClaw CLI; required when projects are configured."
      },
      "humanInput": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boardId",
            "telegramTarget",
            "ownerIds",
            "maxRoutineHours",
            "maxRoutineCostCents"
          ],
          "properties": {
            "boardId": {
              "type": "string"
            },
            "telegramTarget": {
              "type": "string",
              "pattern": "^[1-9][0-9]+$"
            },
            "ownerIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]+$"
              }
            },
            "accountId": {
              "type": "string"
            },
            "maxRoutineHours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxRoutineCostCents": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "autocode_propose",
      "autocode_proposals",
      "autocode_admit",
      "autocode_submit",
      "autocode_review",
      "autocode_inspect",
      "autocode_investigation_finish",
      "autocode_defer",
      "autocode_design_review",
      "autocode_context"
    ]
  }
}
